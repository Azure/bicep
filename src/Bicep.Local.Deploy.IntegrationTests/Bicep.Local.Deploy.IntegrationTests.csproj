<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Bicep.Core.UnitTests/Bicep.Core.UnitTests.csproj" />
    <ProjectReference Include="../Bicep.Local.Deploy/Bicep.Local.Deploy.csproj" />
    <ProjectReference Include="../Bicep.Local.Extension/Bicep.Local.Extension.csproj" />
    <ProjectReference Include="TestHost\Bicep.Local.Deploy.IntegrationTests.TestHost.csproj" ReferenceOutputAssembly="false" />
    <Compile Remove="TestHost\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" />
  </ItemGroup>

  <Target Name="CopyGrpcSecurityTestHost" AfterTargets="Build">
    <PropertyGroup>
      <GrpcSecurityTestHostOutput>$(MSBuildProjectDirectory)\TestHost\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</GrpcSecurityTestHostOutput>
    </PropertyGroup>
    <ItemGroup>
      <GrpcSecurityTestHostRuntimeIdentifier Include="$(RuntimeIdentifiers)" />
      <GrpcSecurityTestHostFile Include="$(GrpcSecurityTestHostOutput)**\*"
                                Exclude="@(GrpcSecurityTestHostRuntimeIdentifier->'$(GrpcSecurityTestHostOutput)%(Identity)\**\*')" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)GrpcSecurityTestHost" />
    <Copy SourceFiles="@(GrpcSecurityTestHostFile)"
          DestinationFiles="@(GrpcSecurityTestHostFile->'$(OutDir)GrpcSecurityTestHost\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
