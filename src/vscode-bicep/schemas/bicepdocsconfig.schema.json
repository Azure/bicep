{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bicep documentation configuration",
  "description": "Configures Bicep module documentation generation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "The JSON schema URI used by editors.",
      "type": "string",
      "format": "uri"
    },
    "input": {
      "$ref": "#/definitions/input"
    },
    "output": {
      "$ref": "#/definitions/output"
    },
    "template": {
      "$ref": "#/definitions/template"
    },
    "examples": {
      "$ref": "#/definitions/examples"
    }
  },
  "definitions": {
    "input": {
      "description": "Configures module input discovery for a target directory.",
      "type": "object",
      "additionalProperties": false,
      "default": {
        "include": [
          "main.bicep"
        ],
        "exclude": []
      },
      "properties": {
        "include": {
          "description": "Case-insensitive glob patterns that select module files relative to the target directory.",
          "type": "array",
          "default": [
            "main.bicep"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "description": "Case-insensitive glob patterns that exclude module files relative to the target directory.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "description": "Configures generated output.",
      "type": "object",
      "additionalProperties": false,
      "default": {
        "file": "README.md"
      },
      "properties": {
        "file": {
          "description": "The output file name.",
          "type": "string",
          "default": "README.md",
          "minLength": 1
        }
      }
    },
    "template": {
      "description": "Configures custom Scriban rendering.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "The template file path.",
          "type": "string",
          "minLength": 1
        },
        "includeRoot": {
          "description": "The root directory for Scriban includes.",
          "type": "string",
          "minLength": 1
        },
        "values": {
          "description": "Custom template values.",
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "description": "Configures example discovery and reassignment.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "description": "The ordered example sources. The first source that resolves a file wins.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/exampleSource"
          }
        },
        "reassignments": {
          "description": "The ordered rules that reassign parent examples to direct child modules.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/exampleReassignment"
          }
        }
      }
    },
    "exampleSource": {
      "description": "Configures one example source.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "description": "The source directory path, relative to the module root.",
          "type": "string",
          "minLength": 1
        },
        "include": {
          "description": "Case-insensitive include glob patterns, relative to the source directory.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "description": "Case-insensitive exclude glob patterns, relative to the source directory.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exampleReassignment": {
      "description": "Reassigns matching parent examples to one direct child module.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/definitions/exampleSelector"
        },
        "to": {
          "description": "The direct child module directory name.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exampleSelector": {
      "description": "Selects example paths for reassignment.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include"
      ],
      "properties": {
        "include": {
          "description": "Case-insensitive include glob patterns relative to the examples directory.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "description": "Case-insensitive exclude glob patterns relative to the examples directory.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
