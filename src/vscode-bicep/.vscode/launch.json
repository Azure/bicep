// A launch configuration that compiles the extension and then opens it inside a new window
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Extension (dev)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--enable-proposed-api=ms-azuretools.vscode-bicep", "--extensionDevelopmentPath=${workspaceRoot}"],
      "sourceMaps": true,
      "preLaunchTask": "${defaultBuildTask}",
      "env": {
        "BICEP_TRACING_ENABLED": "true",
        "BICEP_TRACING_VERBOSITY": "basic",
        "BICEP_LANGUAGE_SERVER_PATH": "${workspaceRoot}/../Bicep.LangServer/bin/Debug/net10.0/Bicep.LangServer.dll",
        "BICEP_MCP_SERVER_PATH": "${workspaceRoot}/../Bicep.McpServer/bin/Debug/net10.0/Azure.Bicep.McpServer.dll"
      }
    },
    {
      "name": "Launch Extension: Prod",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--enable-proposed-api=ms-azuretools.vscode-bicep", "--extensionDevelopmentPath=${workspaceRoot}"],
      "sourceMaps": true,
      "preLaunchTask": "build:prod",
      "env": {
        "BICEP_LANGUAGE_SERVER_PATH": "${workspaceRoot}/../Bicep.LangServer/bin/Debug/net10.0/Bicep.LangServer.dll",
        "BICEP_MCP_SERVER_PATH": "${workspaceRoot}/../Bicep.McpServer/bin/Debug/net10.0/Azure.Bicep.McpServer.dll"
      }
    },
    {
      "name": "Launch Extension: Watch",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--enable-proposed-api=ms-azuretools.vscode-bicep", "--extensionDevelopmentPath=${workspaceRoot}"],
      "sourceMaps": true,
      "preLaunchTask": "watch",
      "env": {
        "BICEP_LANGUAGE_SERVER_PATH": "${workspaceRoot}/../Bicep.LangServer/bin/Debug/net10.0/Bicep.LangServer.dll",
        "BICEP_MCP_SERVER_PATH": "${workspaceRoot}/../Bicep.McpServer/bin/Debug/net10.0/Azure.Bicep.McpServer.dll"
      }
    },
    {
      "name": "Launch Tests: E2E (prod)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--enable-proposed-api=ms-azuretools.vscode-bicep",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/out/tests/e2e/runner/extension-host"
      ],
      "preLaunchTask": "build:e2e",
      "env": {
        "BICEP_LANGUAGE_SERVER_PATH": "${workspaceRoot}/../Bicep.LangServer/bin/Debug/net10.0/Bicep.LangServer.dll",
        "BICEP_MCP_SERVER_PATH": "${workspaceRoot}/../Bicep.McpServer/bin/Debug/net10.0/Azure.Bicep.McpServer.dll",
        "TEST_MODE": "e2e"
      }
    },
    {
      "name": "Launch Tests: E2E (dev)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--enable-proposed-api=ms-azuretools.vscode-bicep",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/out/tests/e2e/runner/extension-host"
      ],
      "preLaunchTask": "build:e2e:dev",
      "env": {
        "BICEP_LANGUAGE_SERVER_PATH": "${workspaceRoot}/../Bicep.LangServer/bin/Debug/net10.0/Bicep.LangServer.dll",
        "BICEP_MCP_SERVER_PATH": "${workspaceRoot}/../Bicep.McpServer/bin/Debug/net10.0/Azure.Bicep.McpServer.dll",
        "TEST_MODE": "e2e"
      }
    },
    {
      "name": "Launch Tests: Unit Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--config", "vitest.config.mts", "--testTimeout=600000"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Launch Tests: Unit Tests: Current File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}", "--config", "vitest.config.mts", "--coverage.enabled=false", "--testTimeout=600000"],
      "console": "integratedTerminal"
    }
  ]
}
