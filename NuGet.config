<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="deployments-local" value="Q:\Code\AzureUX-Deployments-ParameterProvenance\Out\Debug-x64\NuGetPackages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="azure-default">
      <package pattern="*" />
    </packageSource>
    <packageSource key="deployments-local">
      <package pattern="Azure.Deployments.Core" />
      <package pattern="Azure.Deployments.DiffEngine" />
      <package pattern="Azure.Deployments.Engine" />
      <package pattern="Azure.Deployments.Expression" />
      <package pattern="Azure.Deployments.Extensibility" />
      <package pattern="Azure.Deployments.Templates" />
    </packageSource>
    <packageSource key="Local">
      <package pattern="Azure.Bicep.CommandLine.*" />
      <package pattern="Azure.Bicep.MSBuild" />
    </packageSource>
    <packageSource key="vs-impl">
      <package pattern="Microsoft.Test.Apex.VisualStudio" />
    </packageSource>
  </packageSourceMapping>
</configuration>
